# Secret path segment for the public MCP endpoint (/mcp/<secret>).
# Generate with: pnpm secret
MCP_SECRET=

# Public MCP port (the only port exposed through ngrok).
PORT=3333

# Loopback-only control port (tabuleiro do humano, report). Never expose it.
CONTROL_PORT=3334

# Minutes without activity before a game expires (counted as abandoned).
GAME_TTL_MINUTES=60
